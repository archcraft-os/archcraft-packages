## Show the Archcraft About dialog. Display the ISO version as vMAJOR.MINOR
## when available, or show "rolling" on installations without an ISO version.

author='Aditya Shakya <adi1090x@gmail.com>'
website='https://archcraft.io'
version='rolling'

# Read the version once. The third variable absorbs any patch or build fields.
if [[ -r /version ]]; then
	IFS=. read -r major minor remainder < /version

	# Use the parsed fields even if the file has no trailing newline.
	if [[ -n $major && -n $minor ]]; then
		version="v${major}.${minor}"
	fi
fi

exec yad --about \
	--title='About Archcraft' \
	--window-icon='archcraft-cyan' \
	--pname='Archcraft' \
	--pversion="$version" \
	--image='distributor-logo-archcraft' \
	--comments='A thoughtfully crafted Linux desktop experience, based on Arch Linux.' \
	--copyright="Copyright 2020-$(date +%Y), $author" \
	--license='GPL3' \
	--website="$website" \
	--website-label="${website#https://}" \
	--authors="$author"
